# Copy to .env and edit. Every value here is optional -- the setup wizard in the
# web UI can configure the Plex connection without any of these being set.

# Timezone used for the scheduler and for timestamps in the UI. Must be a tz
# database name (e.g. Europe/London). An unknown value logs a warning and falls
# back to the system default rather than failing to start.
TZ=America/New_York

# User/group that should own the files in /config. Match these to the owner of
# the dataset you bind-mount, or the app cannot write its database.
# On TrueNAS SCALE the `apps` user is usually 568:568.
PUID=568
PGID=568

# Port the web UI listens on inside the container. The compose files pin this
# to 8577 directly so it always pairs with the published `8577:8577` mapping --
# change both together, or change neither.
PORT=8577

# debug | info | warning | error
LOG_LEVEL=info

# --- Optional first-boot pre-seeds ------------------------------------------
# These are applied ONLY when the setting is still empty, i.e. on first boot.
# After that the web UI owns them, so editing this file later does nothing --
# that is deliberate, otherwise a stale compose file would silently clobber
# whatever you configured in the browser.

# If Plex runs with host networking, use the NAS LAN IP rather than a container
# name, e.g. http://192.168.1.10:32400
#PLEX_URL=http://plex:32400

# Pre-seed the owner's Plex token. Leave unset to sign in with the plex.tv link
# code from the setup wizard instead (recommended -- no token hunting).
#PLEX_TOKEN=
